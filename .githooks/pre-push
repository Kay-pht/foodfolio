#!/usr/bin/env bash
set -euo pipefail

remote_name="${1:-}"
remote_url="${2:-}"

while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "${remote_ref}" == "refs/heads/main" ]]; then
    cat >&2 <<'EOF'
ERROR: direct pushes to main are prohibited by Foodfolio policy.
Create or update a task branch and merge through a pull request.
Do not bypass this hook with --no-verify.
EOF
    exit 1
  fi
done
