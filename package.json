{
  "name": "foodfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "uuid": "11.1.1"
  },
  "allowScripts": {
    "cpu-features": false
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev:api": "tsx watch src/entrypoints/api.ts",
    "dev:worker": "tsx watch src/entrypoints/worker.ts",
    "dev:local": "node scripts/dev-local.mjs",
    "dev:local:down": "docker compose down",
    "start:api": "node dist/src/entrypoints/api.js",
    "start:worker": "node dist/src/entrypoints/worker.js",
    "prisma:generate": "DATABASE_DIRECT_URL=postgresql://localhost:5432/generate prisma generate",
    "prisma:validate": "DATABASE_DIRECT_URL=postgresql://localhost:5432/validate prisma validate",
    "prisma:format": "DATABASE_DIRECT_URL=postgresql://localhost:5432/format prisma format",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "tasks:sync": "node scripts/sync-task-files.mjs",
    "tasks:check": "node scripts/sync-task-files.mjs --check",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "check:push-policy": "node scripts/test-push-policy.mjs",
    "check:specs": "node scripts/check-specs.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "verify:autonomous-p0": "node scripts/verify-autonomous-p0.mjs",
    "review:lgtm": "node scripts/review-proof.mjs",
    "pr:merge": "node scripts/pr-final-merge.mjs",
    "format:write": "prettier --write .",
    "format": "npm run tasks:sync && npm run format:write",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "fix:backend": "npm run tasks:sync && npm run format:write && npm run lint:fix && npm run format:write && npm run prisma:format",
    "poc:url": "tsx poc/url-extraction/run.ts",
    "poc:ai": "tsx poc/ai-extraction/run.ts",
    "poc:ai:zai": "POC_PROVIDERS=zai tsx poc/ai-extraction/run.ts",
    "poc:ai:gemini": "POC_PROVIDERS=gemini tsx poc/ai-extraction/run.ts",
    "poc:ai:reevaluate": "tsx poc/ai-extraction/reevaluate.ts",
    "poc:gemini-url": "tsx poc/ai-extraction/run-gemini-url-context.ts",
    "poc:e2e": "tsx poc/end-to-end/run.ts",
    "poc:jev-gate": "tsx poc/jev-recipe-gate/run.ts",
    "poc:jev-media": "tsx poc/jev-recipe-gate/run-media.ts",
    "poc:jev-media-live": "tsx poc/jev-recipe-gate/run-media-live.ts",
    "poc:tiktok-video": "bash poc/tiktok-video/run.sh",
    "ios:push:simulator": "bash scripts/push-simulator-notification.sh",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:ios": "bash scripts/test-ios.sh",
    "test:dev:e2e": "node scripts/verify-dev-e2e.mjs",
    "deploy:hosting": "GOOGLE_CLOUD_QUOTA_PROJECT=foodfolio-af28aa npx --yes firebase-tools@15.29.0 deploy --only hosting --project foodfolio-af28aa",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "verify:ios": "IOS_EXPECTED_TEST_COUNT=110 bash scripts/verify-ios.sh",
    "verify": "npm run tasks:check && npm run verify:autonomous-p0 && npm run format:check && npm run lint && npm run check:architecture && npm run check:docs && npm run prisma:generate && npm run prisma:validate && npm run build && npm run test:unit && npm run test:integration && npm run test:e2e"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.0.1",
    "@google-cloud/tasks": "^7.0.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "ajv": "^8.17.1",
    "cheerio": "^1.1.2",
    "dotenv": "^17.2.2",
    "fastify": "^5.12.1",
    "firebase-admin": "^14.3.0",
    "ipaddr.js": "^2.2.0",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^24.3.1",
    "@types/pg": "^8.15.5",
    "eslint": "^9.35.0",
    "pg": "^8.16.3",
    "prettier": "3.9.6",
    "prisma": "^7.10.0",
    "testcontainers": "^12.1.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
