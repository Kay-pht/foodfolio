      "recipe": {
        "title": "豚バラ肉と白菜のとろとろ煮",
        "servings": {
          "value": 2,
          "raw": "2 servings"
        },
        "cookingTimeMinutes": 20,
        "genre": "主菜",
        "ingredients": [
          {
            "name": "豚バラ肉",
            "amount": "200g"
          },
          {
            "name": "白菜",
            "amount": "300g"
          },
          {
            "name": "めんつゆ",
